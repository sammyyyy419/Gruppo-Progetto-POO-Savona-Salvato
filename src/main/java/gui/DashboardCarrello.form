<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.DashboardCarrello">
  <grid id="27dc6" binding="panelCarrello" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="8fe28" binding="scrollCarrello">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="37c5f" binding="listaElementiCarrello" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints/>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </scrollpane>
      <grid id="84071" binding="panelTitoloCarrello" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ae30" class="javax.swing.JButton" binding="tornaAlMenuButton" default-binding="true">
            <constraints/>
            <properties>
              <horizontalAlignment value="2"/>
              <text value="Torna al menu"/>
            </properties>
          </component>
          <component id="b6be2" class="javax.swing.JLabel" binding="labelCarrello">
            <constraints/>
            <properties>
              <font size="28" style="1"/>
              <text value="Carrello"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="505fe" binding="panelPagamento" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ba7aa" class="javax.swing.JLabel" binding="labelTotale">
            <constraints border-constraint="West"/>
            <properties>
              <font size="16" style="1"/>
              <text value="TOT. : "/>
            </properties>
          </component>
          <component id="71b5" class="javax.swing.JButton" binding="buttonPagamento">
            <constraints border-constraint="Center"/>
            <properties>
              <enabled value="false"/>
              <font size="20" style="3"/>
              <text value="Vai al Pagamento"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
