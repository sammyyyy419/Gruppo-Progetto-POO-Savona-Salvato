<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.DashboardRimborso">
  <grid id="27dc6" binding="panelRimborso" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="24" y="20" width="518" height="214"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a6077" binding="panelTop" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="53af1" class="javax.swing.JButton" binding="annulaButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Annula"/>
            </properties>
          </component>
          <component id="eb973" class="javax.swing.JLabel" binding="labelRimborso">
            <constraints/>
            <properties>
              <font size="22" style="3"/>
              <text value="Dati Rimborso"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="dca8e" binding="panelDati" layout-manager="GridBagLayout">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="bdae3" class="javax.swing.JLabel" binding="labelIBAN">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="IBAN : "/>
            </properties>
          </component>
          <component id="146d4" class="javax.swing.JTextField" binding="textIBAN">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="875ac" binding="panelBottom" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="90046" class="javax.swing.JLabel" binding="labelTotRimborso">
            <constraints/>
            <properties>
              <text value="TOT. : "/>
            </properties>
          </component>
          <component id="27de" class="javax.swing.JButton" binding="autorizzaRimborsoButton" default-binding="true">
            <constraints/>
            <properties>
              <enabled value="false"/>
              <text value="Autorizza Rimborso"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
