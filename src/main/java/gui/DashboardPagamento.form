<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.DashboardPagamento">
  <grid id="27dc6" binding="panelPagamento" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="646" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a3d0b" binding="panelAlto" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="f2461" class="javax.swing.JButton" binding="tornaAlMenuButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Torna al menu"/>
            </properties>
          </component>
          <component id="ed7eb" class="javax.swing.JLabel" binding="labelTitolo">
            <constraints/>
            <properties>
              <font size="20" style="2"/>
              <text value="PAGAMENTO"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="2e982" binding="panelCentrale" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="6e31f" class="javax.swing.JLabel" binding="labelTipoPagamento">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Tipo di Pagamento : "/>
            </properties>
          </component>
          <grid id="953a1" binding="panelCampiCarta" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="b2b8f" class="javax.swing.JLabel" binding="labelNumeroCarta">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Numero Carta : "/>
                </properties>
              </component>
              <component id="f943c" class="javax.swing.JTextField" binding="textNumeroCarta">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
                    <minimum-size width="150" height="-1"/>
                    <preferred-size width="150" height="-1"/>
                    <maximum-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="da18" class="javax.swing.JLabel" binding="labelCVC">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="CVC : "/>
                </properties>
              </component>
              <component id="95997" class="javax.swing.JTextField" binding="textCVC">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="b4ffb" class="javax.swing.JLabel" binding="labelDataScadenza">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Data Scadenza : "/>
                </properties>
              </component>
              <component id="441ee" class="javax.swing.JTextField" binding="textDataScadenza">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="60112" class="javax.swing.JLabel" binding="labelIntestatario">
                <constraints>
                  <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Intestatario : "/>
                </properties>
              </component>
              <component id="691e8" class="javax.swing.JTextField" binding="textIntestatario">
                <constraints>
                  <grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="1b64b" class="javax.swing.JLabel" binding="labelCodiceSconto">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Codice Sconto : "/>
                </properties>
              </component>
              <component id="bca79" class="javax.swing.JTextField" binding="textCodiceSconto">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
            </children>
          </grid>
          <component id="89f88" class="javax.swing.JComboBox" binding="comboTipoPagamento">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="4853d" class="javax.swing.JButton" binding="buttonConferma">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <enabled value="false"/>
              <font size="20" style="2"/>
              <text value="Conferma Pagamento"/>
            </properties>
          </component>
          <component id="dce40" class="javax.swing.JLabel" binding="labelRiepilogo">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Riepilogo Tot. : "/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
