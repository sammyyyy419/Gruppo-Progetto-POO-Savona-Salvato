        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="8ffc4" class="javax.swing.JLabel" binding="labelPopCorn">
            <constraints/>
            <properties>
              <horizontalAlignment value="10"/>
              <text value="PopCorn : "/>
            </properties>
          </component>
          <component id="16cab" class="javax.swing.JLabel" binding="labelTipoPopCorn">
            <constraints/>
            <properties>
              <text value="PopCorn"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="cf149" binding="panelNachos" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="2" hsize-policy="2" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="55d54" class="javax.swing.JLabel" binding="labelNachos">
            <constraints/>
            <properties>
              <text value="Nachos : "/>
            </properties>
          </component>
          <component id="9158c" class="javax.swing.JLabel" binding="labelTipoNachos">
            <constraints/>
            <properties>
              <text value="Nachos"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="791eb" binding="panelBibite" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="2" hsize-policy="2" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="de0df" class="javax.swing.JLabel" binding="labelBibite">
