<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.DashboardBar">
  <grid id="27dc6" binding="panelBar" layout-manager="GridLayoutManager" row-count="5" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="797" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="acbb8" class="javax.swing.JLabel" binding="labelBar">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="1" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="24" style="2"/>
          <horizontalAlignment value="0"/>
          <horizontalTextPosition value="0"/>
          <text value="Il nostro Menù Bar : "/>
          <verticalAlignment value="1"/>
        </properties>
      </component>
      <grid id="f1b4b" binding="panelPopCorn" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints>
