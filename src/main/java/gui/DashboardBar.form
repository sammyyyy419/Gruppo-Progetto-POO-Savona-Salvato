          </component>
        </children>
      </grid>
      <component id="653a6" class="javax.swing.JButton" binding="buttonTorna">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
